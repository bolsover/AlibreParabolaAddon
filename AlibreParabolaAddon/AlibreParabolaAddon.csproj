<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')"/>
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <ProjectGuid>{67F60C6E-7448-48A2-A4A0-48AF25EB2F02}</ProjectGuid>
        <!-- A managed Alibre add-on: a class library loaded into Alibre Design.exe. -->
        <OutputType>Library</OutputType>
        <RootNamespace>AlibreParabolaAddon</RootNamespace>
        <AssemblyName>AlibreParabolaAddon</AssemblyName>
        <!-- Alibre Design.exe.config declares sku .NETFramework,Version=v4.8; match the host. -->
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <FileAlignment>512</FileAlignment>
        <Deterministic>true</Deterministic>
        <LangVersion>7.3</LangVersion>
        <!-- Alibre's AlibreX / AlibreAddOn interop assemblies are AMD64-only, and the
             add-on only ever runs inside 64-bit Alibre. -->
        <PlatformTarget>x64</PlatformTarget>
        <!-- Alibre's Program folder, for the AlibreX / AlibreAddOn interop assemblies.
             Override on the command line: /p:AlibreProgramDir=... -->
        <AlibreProgramDir Condition=" '$(AlibreProgramDir)' == '' ">C:\Program Files\Alibre Design 29.1.0.29127\Program</AlibreProgramDir>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
    <ItemGroup>
        <!-- Private=False: Alibre already has these loaded; never ship copies. -->
        <Reference Include="AlibreAddOn">
          <HintPath>C:\Program Files\Alibre Design 29.1.1.29133\Program\AlibreAddOn.dll</HintPath>
        </Reference>
        <Reference Include="AlibreX">
          <HintPath>C:\Program Files\Alibre Design 29.1.1.29133\Program\AlibreX.dll</HintPath>
        </Reference>
        <Reference Include="System"/>
        <Reference Include="System.Core"/>
        <Reference Include="System.Drawing"/>
        <Reference Include="System.Windows.Forms"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="ParabolaAddOn.cs" />
        <Compile Include="AlibreAddOn.cs"/>
        <Compile Include="AlibreVersion.cs"/>
        <Compile Include="ParabolaCommand.cs"/>
        <Compile Include="ParabolaForm.cs"/>
        <Compile Include="ParabolaGeometry.cs"/>
        <Compile Include="SketchTarget.cs"/>
        <Compile Include="Properties\AssemblyInfo.cs"/>
    </ItemGroup>
    <ItemGroup>
        <Content Include="AlibreParabolaAddon.adc">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
